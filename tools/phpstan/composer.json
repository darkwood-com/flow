{
	"require": {
        "php": ">=8.5",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/string": "^8.1"
    },
    "require-dev": {
        "amphp/amp": "^3.1",
        "doctrine/dbal": "^4.3",
        "openswoole/ide-helper": "^26.2.0",
        "phpstan/phpstan": "^2.1 <2.1.56",
        "react/async": "^4.3",
        "spatie/async": "^1.8",
        "symfony/doctrine-messenger": "^8.1",
        "symfony/http-client": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Flow\\": "../../src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flow\\Examples\\": "../../examples",
            "Flow\\Test\\": "../../tests"
        }
    },
    "config": {
        "platform": {
            "ext-openswoole": "26.2.0"
        }
    }
}
