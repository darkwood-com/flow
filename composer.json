{
    "name": "darkwood/flow",
    "description": "Flow",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "amphp",
        "async",
        "fiber",
        "monad",
        "reactphp",
        "spatie",
        "swoole",
        "symfony",
        "php"
    ],
    "require": {
        "php": ">=8.5",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/string": "^8.1"
    },
    "require-dev": {
        "amphp/amp": "^3.1",
        "doctrine/dbal": "^4.3",
        "openswoole/ide-helper": "^26.2.0",
        "react/async": "^4.3",
        "spatie/async": "^1.8",
        "symfony/doctrine-messenger": "^8.1",
        "symfony/http-client": "^8.1"
    },
    "suggest": {
        "amphp/amp": "Provide asynchronous with AMP",
        "ext-async": "Provides the experimental TrueAsync driver for Flow",
        "ext-openswoole": "Provide asynchronous with OpenSwoole",
        "react/async": "Provide asynchronous with ReactPHP",
        "symfony/messenger": "Provide Symfony Messenger support",
        "spatie/async": "Provide asynchronous with Spatie"
    },
    "autoload": {
        "psr-4": {
            "Flow\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flow\\Examples\\": "examples",
            "Flow\\Test\\": "tests"
        }
    },
    "scripts": {
        "env": "cd tools && castor flow:tools:env",
        "docs-serve": "cd tools && castor flow:tools:docs-serve",
        "php-cs-fixer": "cd tools && castor flow:tools:php-cs-fixer",
        "phpstan": "cd tools && castor flow:tools:phpstan",
        "phpunit": "cd tools && castor flow:tools:phpunit"
    },
    "config": {
        "platform": {
            "ext-openswoole": "26.2.0"
        }
    },
    "minimum-stability": "stable"
}
